{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kelime Ustası",
  "version": "1.0.0",
  "identifier": "com.erebb.kelimeustasi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kelime Ustası",
        "width": 460,
        "height": 880,
        "minWidth": 360,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Education",
    "shortDescription": "Oyunlaştırılmış kelime öğrenme",
    "longDescription": "Kendi kelime listelerini yükle; TikTok tarzı akış, aralıklı tekrarlı kartlar ve canlı quiz ile çalış.",
    "copyright": "© 2026 erebb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
