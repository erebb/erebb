{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kelime Ustası",
  "version": "../package.json",
  "identifier": "com.erebb.kelimeustasi",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kelime Ustası",
        "width": 440,
        "height": 780,
        "minWidth": 360,
        "minHeight": 560,
        "resizable": true,
        "center": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://api.github.com https://raw.githubusercontent.com"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "category": "Education",
    "shortDescription": "Oyunlaştırılmış kelime öğrenme",
    "longDescription": "Kendi kelime listelerini yükle; TikTok tarzı akış, aralıklı tekrarlı kartlar ve canlı quiz ile çalış.",
    "copyright": "© 2026 erebb",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBMDI2NDM2N0E5NzdDMkIKUldRcmZKZDZObVFDZXRrOXg4Q3VEcis2UUNmYmkxSFBCWUwxVTBFTU4yaCswcnJrUDNFRnp0K3EK",
      "endpoints": [
        "https://github.com/erebb/erebb/releases/latest/download/latest.json"
      ]
    }
  }
}
