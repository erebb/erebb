{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Ana pencere: çekirdek varsayılanlar + tam ekran, güncelleme (denetle/kur), yeniden başlatma ve yalnız GitHub sürüm sayfasını tarayıcıda açma.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-set-fullscreen",
    "updater:default",
    "process:allow-restart",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        {
          "url": "https://github.com/erebb/erebb/*"
        }
      ]
    }
  ]
}
